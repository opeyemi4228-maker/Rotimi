# Postgres. Use the POOLED connection string from Neon — the host ends in
# "-pooler". The unpooled one runs out of connections under any real traffic.
#
# End it with sslmode=verify-full, not the sslmode=require Neon hands you.
# pg treats "require" as verify-full today but warns that it will drop to
# libpq semantics in pg v9 — encrypted, but with the server certificate
# unchecked, which is a connection a man in the middle can terminate. This
# database holds the member register and encrypted NINs, so state the strict
# mode rather than inherit the weak one at some future upgrade.
#   postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/map?sslmode=verify-full
DATABASE_URL=

# Signs the member session cookie. Sessions cannot be issued without it.
# Generate:  openssl rand -base64 48
SESSION_SECRET=

# Encrypts NIN at rest (AES-256-GCM). Must be exactly 32 bytes, base64.
# Generate:  openssl rand -base64 32
# If unset, a submitted NIN is DISCARDED rather than stored in plaintext.
NIN_ENCRYPTION_KEY=


